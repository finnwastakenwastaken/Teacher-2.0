APP_NAME="Teacher"
APP_ENV=production
APP_KEY=
# Passkey enrolments are derived from this. install.sh generates one; if it is
# left empty Fortify falls back to APP_KEY, which means rotating the
# application key — an ordinary operation — silently unenrols every passkey
# and there is no way to get them back. Keep this value even when rotating
# APP_KEY, and keep it out of anything you share.
PASSKEYS_USER_HANDLE_SECRET=
APP_DEBUG=false
APP_URL=https://example.com

# Dutch is the interface language for both the public site and the admin panel.
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL
# Leave this alone once the site has content. Laravel writes timestamps in
# this zone, so changing it later means old rows are in one zone and new ones
# in another, with nothing recording which is which. UTC is the safe default;
# only "x dagen geleden" and backup filenames are affected, and the first of
# those is relative anyway.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# DB_HOST is overridden to `database` by compose; the value here is for running
# artisan outside the stack.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=teacher
DB_USERNAME=teacher
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# `sync`, not `database`: there is no queue worker in this stack and adding
# one is deliberately deferred. Nothing dispatches a job today, but with
# `database` the first one anyone adds would be written to a table nothing
# reads and vanish without an error. `sync` runs it inline instead — slower,
# and visible.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# All uploaded media is private and served only through the gated controller.
# Do not point this at the `public` disk — that would bypass password checks.
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# First-run admin account
#
# Leave ADMIN_* blank to claim the single account through the browser the first
# time /admin is opened. That window is first-come-first-served: claim it
# immediately after the site becomes reachable, before sharing the address.
#
# Set ADMIN_SETUP_TOKEN to close that window — the claim screen will then also
# require this value. Recommended if there is any gap between going live and
# claiming the account.
#
# Alternatively pre-seed the account by filling in all three ADMIN_ fields
# before the first boot. Clear ADMIN_PASSWORD from this file afterwards.
# -----------------------------------------------------------------------------
ADMIN_SETUP_TOKEN=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# Only needed when running the `tunnel` compose profile.
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------
# How long a visitor stays unlocked after entering a page password, in days.
ACCESS_UNLOCK_DAYS=30

# Wrong password attempts allowed per minute, per IP, per password.
ACCESS_ATTEMPTS_PER_MINUTE=5

# The IP-independent backstop, as a multiple of the line above: attempts
# against one password from everywhere at once. A per-IP limit bounds one
# attacker, not the total, because addresses are cheap. 5 x 10 = 50 a minute.
ACCESS_GLOBAL_ATTEMPT_MULTIPLIER=10

# Upload chunk size in bytes. Must stay well below Cloudflare's 100 MB request
# body limit; 20 MB leaves generous headroom for overhead.
MEDIA_CHUNK_BYTES=20971520

# Largest single file accepted through the browser. Anything larger is
# registered from disk with `php artisan media:import` instead.
MEDIA_MAX_BYTES=2147483648

# Chunk data for uploads that were started and never finished is deleted after
# this many hours. Pruning runs automatically on every container boot.
MEDIA_UPLOAD_TTL_HOURS=24

# Directory scanned by `php artisan media:import`, for files too large to
# upload through the browser at all. In production this is a bind mount — see
# compose.yaml — so a file dropped in ./storage-import on the host shows up
# here inside the container.
MEDIA_IMPORT_PATH=/var/www/html/storage/app/import

# Hand finished downloads to nginx with X-Accel-Redirect instead of streaming
# them through PHP. Leave this on. Turning it off ties up a PHP-FPM worker for
# the entire duration of every download, and a class watching one video would
# exhaust the pool — it exists only so the test suite and a bare
# `artisan serve` are not silently broken. See the technical reference.
MEDIA_X_ACCEL=true

# SVG uploads. These are served as downloads with a sandbox CSP and never
# inlined, so a hostile SVG cannot execute in the site's origin. Set to false
# to refuse them outright.
MEDIA_ALLOW_SVG=true

VITE_APP_NAME="${APP_NAME}"
