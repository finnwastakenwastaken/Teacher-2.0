# Keep the build context small and deterministic.
#
# WARNING: anything excluded here that the application needs at runtime must be
# recreated in the Dockerfile. The storage/* exclusions below drop directories
# that contain only .gitignore files — the production stage recreates them with
# an explicit mkdir. Removing that mkdir produces a container that boots and
# then fails on the first write.

.git
.github
.gitignore
.gitattributes

# Installed inside the image by the build stage.
node_modules
vendor

# Build output — regenerated, never copied in.
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr
bootstrap/cache/*.php

# Generated by Wayfinder during the build.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Runtime state. Directories are recreated in the Dockerfile.
storage/app/private/*
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/pail
storage/*.key

# Secrets must never enter an image layer.
.env
.env.*
!.env.example
auth.json

# Bind-mounted at runtime for `php artisan media:import`. Whatever the
# operator has staged there is not part of the image.
storage-import

# Read on the host, never inside a container.
install.sh
update.sh

# Local tooling
.phpunit.cache
.phpunit.result.cache
.idea
.vscode
.zed
.fleet
.nova
.DS_Store
